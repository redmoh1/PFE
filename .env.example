# Environment Variables Configuration
# Copy this file to .env and update values for your environment

# =============================================================================
# Environment
# =============================================================================
ENVIRONMENT=development

# =============================================================================
# API Configuration
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8001
API_RELOAD=true
API_WORKERS=1

# =============================================================================
# Security
# =============================================================================
# CRITICAL: Change this to a secure random key in production!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=CHANGE-THIS-IN-PRODUCTION-USE-RANDOM-256BIT-KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# =============================================================================
# CORS Origins (comma-separated)
# =============================================================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# For production: CORS_ORIGINS=https://yourdomain.com

# Frontend dev proxy target
VITE_API_TARGET=http://127.0.0.1:8001
# Optional: direct frontend API base when bypassing the Vite proxy
VITE_API_BASE=

# Frontend base URL used in verification and password reset emails
FRONTEND_BASE_URL=http://127.0.0.1:3000

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_PER_HOUR=100

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/api.log

# ML Model
MODEL_PATH=src/ml_lifecycle/model_registry/sales_forecast_model.pkl
MODEL_RETRAIN_DAYS=30

# Data paths
DATA_DIR=data
UPLOAD_MAX_SIZE=10485760

# =============================================================================
# Email Delivery
# =============================================================================
# Supported delivery modes: console, smtp, resend.
EMAIL_DELIVERY_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=InsightPro
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
RESEND_API_KEY=
RESEND_API_BASE_URL=https://api.resend.com

# =============================================================================
# Email Verification And Password Reset
# =============================================================================
# Optional: set a dedicated secret for OTP and reset token hashing.
ONE_TIME_TOKEN_SECRET=
EMAIL_VERIFICATION_OTP_MINUTES=10
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=30
EMAIL_VERIFICATION_MAX_SENDS_PER_HOUR=5
PASSWORD_RESET_TOKEN_MINUTES=30
PASSWORD_RESET_REQUEST_COOLDOWN_SECONDS=60
PASSWORD_RESET_MAX_REQUESTS_PER_HOUR=5
