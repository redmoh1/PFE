# Environment Variables Configuration
# Copy this file to .env and update values for your environment

# =============================================================================
# Environment
# =============================================================================
ENVIRONMENT=development

# =============================================================================
# API Configuration
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_WORKERS=1

# =============================================================================
# Security
# =============================================================================
# CRITICAL: Change this to a secure random key in production!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE-THIS-IN-PRODUCTION-USE-RANDOM-256BIT-KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# CORS Origins (comma-separated)
# =============================================================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# For production: CORS_ORIGINS=https://yourdomain.com

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_PER_HOUR=100

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/api.log

# ML Model
MODEL_PATH=src/ml_lifecycle/model_registry/sales_forecast_model.pkl
MODEL_RETRAIN_DAYS=30

# Data paths
DATA_DIR=data
UPLOAD_MAX_SIZE=10485760
