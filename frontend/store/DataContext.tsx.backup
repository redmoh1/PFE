
import React, { createContext, useContext, useState, useEffect } from 'react';
import { useAuth } from './AuthContext';
import { SalesData, ForecastPoint, RFMSegment, Recommendation, SentimentData, KPIData } from '../types';

const API_BASE_URL = 'http://localhost:8000';

interface DataContextType {
  sales: SalesData[];
  forecast: ForecastPoint[];
  segments: RFMSegment[];
  recommendations: Recommendation[];
  sentiment: SentimentData[];
  kpis: KPIData | null;
  lastTrainingDate: string | null;
  isProcessing: boolean;
  isLoading: boolean;
  error: string | null;
  uploadData: (type: string, data: any[]) => void;
  refreshData: () => Promise<void>;
}

const DataContext = createContext<DataContextType | undefined>(undefined);

export const DataProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  const { user } = useAuth();
  const [sales, setSales] = useState<SalesData[]>([]);
  const [forecast, setForecast] = useState<ForecastPoint[]>([]);
  const [segments, setSegments] = useState<RFMSegment[]>([]);
  const [recommendations, setRecommendations] = useState<Recommendation[]>([]);
  const [sentiment, setSentiment] = useState<SentimentData[]>([]);
  const [lastTrainingDate, setLastTrainingDate] = useState<string | null>(null);
  const [isProcessing, setIsProcessing] = useState(false);

  // Load user-specific data from local storage to simulate tenant isolation
  useEffect(() => {
    if (user) {
      const tenantKey = `data_${user.company}`;
      const savedData = localStorage.getItem(tenantKey);
      if (savedData) {
        const parsed = JSON.parse(savedData);
        setSales(parsed.sales || []);
        setForecast(parsed.forecast || []);
        setSegments(parsed.segments || []);
        setRecommendations(parsed.recommendations || []);
        setSentiment(parsed.sentiment || []);
        setLastTrainingDate(parsed.lastTrainingDate || null);
      } else {
        // Initial mock data for fresh users
        generateMockData();
      }
    } else {
      setSales([]);
      setForecast([]);
      setSegments([]);
      setRecommendations([]);
      setSentiment([]);
      setLastTrainingDate(null);
    }
  }, [user]);

  const generateMockData = () => {
    const mockSales: SalesData[] = Array.from({ length: 100 }, (_, i) => ({
      id: `s-${i}`,
      date: new Date(2024, 0, 1 + Math.floor(i / 2)).toISOString().split('T')[0],
      amount: Math.floor(Math.random() * 500) + 100,
      product: ['Enterprise ERP', 'Cloud Storage', 'Security Suite', 'AI Analytics'][Math.floor(Math.random() * 4)],
      category: 'SaaS',
      city: ['New York', 'London', 'San Francisco', 'Tokyo'][Math.floor(Math.random() * 4)],
      customerId: `c-${Math.floor(Math.random() * 20)}`
    }));

    const mockForecast: ForecastPoint[] = [
      { date: '2024-01', actual: 45000, forecast: 44000 },
      { date: '2024-02', actual: 48000, forecast: 46000 },
      { date: '2024-03', actual: 51000, forecast: 50000 },
      { date: '2024-04', forecast: 53000 },
      { date: '2024-05', forecast: 56000 },
      { date: '2024-06', forecast: 59000 },
    ];

    const mockSegments: RFMSegment[] = [
      { name: 'Champions', count: 15, color: '#22C55E' },
      { name: 'Loyal', count: 25, color: '#2563EB' },
      { name: 'Potential Loyalists', count: 30, color: '#64748B' },
      { name: 'At Risk', count: 20, color: '#F59E0B' },
      { name: 'Hibernating', count: 10, color: '#EF4444' },
    ];

    const mockRecs: Recommendation[] = [
      { id: '1', baseProduct: 'Cloud Storage', recommendedProduct: 'Security Suite', confidence: 0.85, lift: 2.1 },
      { id: '2', baseProduct: 'Enterprise ERP', recommendedProduct: 'AI Analytics', confidence: 0.72, lift: 1.8 },
    ];

    const mockSentiment: SentimentData[] = [
      { label: 'Positive', score: 0.8, count: 65 },
      { label: 'Neutral', score: 0.5, count: 25 },
      { label: 'Negative', score: 0.2, count: 10 },
    ];

    setSales(mockSales);
    setForecast(mockForecast);
    setSegments(mockSegments);
    setRecommendations(mockRecs);
    setSentiment(mockSentiment);
    setLastTrainingDate(new Date().toISOString());
  };

  const uploadData = async (type: string, data: any[]) => {
    setIsProcessing(true);
    // Simulate pipeline processing (cleaning, FE, ML training)
    setTimeout(() => {
      if (type === 'sales') setSales(data as SalesData[]);
      setLastTrainingDate(new Date().toISOString());
      setIsProcessing(false);
      
      // Save updated data
      if (user) {
        const tenantKey = `data_${user.company}`;
        localStorage.setItem(tenantKey, JSON.stringify({
          sales: type === 'sales' ? data : sales,
          forecast,
          segments,
          recommendations,
          sentiment,
          lastTrainingDate: new Date().toISOString()
        }));
      }
    }, 2000);
  };

  return (
    <DataContext.Provider value={{
      sales, forecast, segments, recommendations, sentiment, 
      lastTrainingDate, isProcessing, uploadData
    }}>
      {children}
    </DataContext.Provider>
  );
};

export const useData = () => {
  const context = useContext(DataContext);
  if (!context) throw new Error('useData must be used within DataProvider');
  return context;
};
